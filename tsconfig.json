{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "moduleResolution": "node",
        "ignoreDeprecations": "6.0",
        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "rootDir": "src",
        "outDir": "dist",
        "types": [
            "node"
        ]
    },
    "include": [
        "src"
    ]
}